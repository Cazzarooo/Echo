{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "description": "Echo: chat em tempo real com rodas e canais. Servidor, interface web e casca desktop.",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node scripts/dev.mjs",
    "server": "node server/src/index.js",
